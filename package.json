{
  "name": "@ludentes/marshal",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Admissibility and record: allocators, pick(), explained refusals",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ludentes/marshal.git"
  },
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@10.33.0",
  "exports": {
    "./permit": {
      "types": "./dist/permit.d.ts",
      "import": "./dist/permit.js",
      "require": "./dist/permit.js"
    },
    "./pick": {
      "types": "./dist/pick.d.ts",
      "import": "./dist/pick.js",
      "require": "./dist/pick.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^22.5.4",
    "typescript": "^5.7.2",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "API.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
